  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Polly Gone, the 3D designer of this piece, based this work on the ancient
    statue Aphrodite of Milos (Venus de Milo). Aphrodite, the Greek goddess of love
    and beauty, has inspired artists for centuries. Discovered broken on the island
    of Milos in 1820, with her arms lost to history, the original statue has crossed
    wars, seas, and empires to become one of the world\u2019s most famous symbols
    of beauty and loss. This digital reinterpretation echoes her calm, balanced pose
    while inviting you to imagine the missing gesture and the long journey from carved
    marble to virtual form."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
